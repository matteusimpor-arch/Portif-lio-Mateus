rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para Estatísticas do Site (statistics/site)
    match /statistics/{statDoc} {
      // Qualquer visitante pode ler as estatísticas agregadas (visitas e assinaturas)
      allow read: if true;
      
      // Criação ou atualização do documento de estatísticas
      // Permite incremento atômico de totalVisits ou totalSignatures
      allow create, update: if true;
      allow delete: if false;
    }
    
    // Regras para Livro de Visitas (guestbookEntries)
    match /guestbookEntries/{entryId} {
      // Visitantes podem ler apenas mensagens com status 'approved'
      allow read: if resource.data.status == 'approved';
      
      // Visitantes podem criar assinaturas com validação rigorosa de campos e limites
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 200
                    && (request.resource.data.status == 'approved' || request.resource.data.status == 'pending');
      
      // Proibido para usuários comuns editar ou deletar mensagens já salvas
      allow update, delete: if false;
    }
  }
}
